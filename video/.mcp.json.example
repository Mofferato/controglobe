{
  "mcpServers": {
    "qgis": {
      "command": "uvx",
      "args": ["--python", "3.12", "--from", "https://github.com/nkarasiak/qgis-mcp/archive/refs/tags/v0.14.1.zip", "qgis-mcp-server"]
    },
    "gimp": {
      "command": "uv",
      "args": ["run", "--directory", "C:/tools/gimp-mcp", "gimp_mcp_server.py"]
    },
    "davinci-resolve": {
      "command": "C:/tools/davinci-resolve-mcp/venv/Scripts/python.exe",
      "args": ["C:/tools/davinci-resolve-mcp/src/server.py"]
    },
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp"]
    }
  }
}
